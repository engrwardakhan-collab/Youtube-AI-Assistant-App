# YouTube OAuth (Google Cloud OAuth Client)
YT_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
YT_CLIENT_SECRET=your_google_oauth_client_secret

# Your YouTube channel
YOUTUBE_CHANNEL_ID=your_youtube_channel_id

# Paths (these should match your repo structure)
REFRESH_TOKEN_PATH=secrets/refresh_token.txt
ACCESS_TOKEN_PATH=runtime/access_token.json  # where the short-lived access token + expiry are cached
OPENAI_API_KEY_PATH=secrets/openai_api_key.txt
